# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/athlete_verify
# Atlas free: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/athlete_verify
MONGO_URI=mongodb://127.0.0.1:27017/athlete_verify

# Server port
PORT=5000

# Secret used to sign admin login tokens (use a long random string)
JWT_SECRET=change_this_to_a_long_random_string

# Base URL the QR code will point to (your frontend's public/verify page)
# While running locally this can stay as-is
PUBLIC_BASE_URL=http://localhost:5173

# Cloudinary (file storage for photos, documents, and QR codes)
# Sign up free at https://cloudinary.com — find these on your Dashboard home page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ABA PayWay (online fee payments) — from your ABA PayWay merchant portal.
# Leave ABA_PAYWAY_BASE_URL on the sandbox URL below to test with fake money
# first; switch it to https://checkout.payway.com.kh once your merchant
# account is approved for real (production) payments — nothing else needs
# to change. Never commit real values here; set them in Render's
# Environment tab instead.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

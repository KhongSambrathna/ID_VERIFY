# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/athlete_verify
# Atlas free: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/athlete_verify
MONGO_URI=
PORT=5000

# Secret used to sign admin login tokens (use a long random string)
JWT_SECRET=

# Base URL the QR code will point to (your frontend's public/verify page)
# While running locally this can stay as-is
PUBLIC_BASE_URL=http://localhost:5173

# Cloudinary (file storage for photos, documents, and QR codes)
# Sign up free at https://cloudinary.com — find these on your Dashboard home page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The ID app's own Telegram bot (make it with @BotFather — not the shop bot):
# account linking, password reset, site notices. Then: Admin → Telegram → Connect.
TELEGRAM_BOT_TOKEN=
# Bakong Open API (National Bank of Cambodia) — KHQR / interbank payments.
# Get your credentials at https://api-bakong.nbc.gov.kh/
BAKONG_API_TOKEN=
# Base URL of the Bakong API (default below). Override only if your portal
# gives you a different host.
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh/
# Optional: override Bakong endpoint paths if your portal uses different URLs.
# BAKONG_ENDPOINT_CREATE=/api/v1/payment/create
# BAKONG_ENDPOINT_QR_IMAGE=/api/v1/qr-image
# BAKONG_ENDPOINT_CHECK=/api/v1/check-transaction
# Merchant details embedded in generated KHQR codes.
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=

# App link — lets Tournament / Shop read teams + players from ID (read-only).
# One "app:secret" pair per app, comma separated; each secret 16+ random characters.
# The same secret goes into that app as ID_LINK_KEY.
# Import students from the school-management app (Admin → 🏫 Import from school).
# SCHOOL_MONGO_URI = the MONGO_URI from school-management's backend/.env
# (database school_management). SCHOOL_PUBLIC_URL = that backend's address,
# only needed for photos it saved on its own disk (/uploads/...), e.g.
# http://localhost:5000 locally — photos on Cloudinary work without it.
SCHOOL_MONGO_URI=
SCHOOL_PUBLIC_URL=

# Add a "school:" key so the school-management app can show students their
# own training (🏃) — e.g. tournament:…,school:another-long-random-secret
LINK_API_KEYS=tournament:change-me-to-a-long-random-secret

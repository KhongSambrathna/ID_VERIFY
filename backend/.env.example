# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/athlete_verify
# Atlas free: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/athlete_verify
MONGO_URI=
PORT=5000

# Secret used to sign admin login tokens (use a long random string)
JWT_SECRET=

# Base URL the QR code will point to (your frontend's public/verify page)
# While running locally this can stay as-is
PUBLIC_BASE_URL=http://localhost:5173

# Cloudinary (file storage for photos, documents, and QR codes)
# Sign up free at https://cloudinary.com — find these on your Dashboard home page
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TELEGRAM_BOT_TOKEN = 
# Bakong Open API (National Bank of Cambodia) — KHQR / interbank payments.
# Get your credentials at https://api-bakong.nbc.gov.kh/
BAKONG_API_TOKEN=
# Base URL of the Bakong API (default below). Override only if your portal
# gives you a different host.
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh/
# Optional: override Bakong endpoint paths if your portal uses different URLs.
# BAKONG_ENDPOINT_CREATE=/api/v1/payment/create
# BAKONG_ENDPOINT_QR_IMAGE=/api/v1/qr-image
# BAKONG_ENDPOINT_CHECK=/api/v1/check-transaction
# Merchant details embedded in generated KHQR codes.
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=

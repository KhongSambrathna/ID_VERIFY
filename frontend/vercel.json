{
  "redirects": [
    {
      "source": "/shop",
      "destination": "https://shop.brathna.com/",
      "permanent": true
    },
    {
      "source": "/admin/shop",
      "destination": "https://shop.brathna.com/admin/shop",
      "permanent": true
    },
    {
      "source": "/admin/invoices",
      "destination": "https://shop.brathna.com/admin/invoices",
      "permanent": true
    },
    {
      "source": "/admin/invoices/:id",
      "destination": "https://shop.brathna.com/admin/invoices/:id",
      "permanent": true
    },
    {
      "source": "/admin/purchase-plans",
      "destination": "https://shop.brathna.com/admin/purchase-plans",
      "permanent": true
    },
    {
      "source": "/admin/finance",
      "destination": "https://shop.brathna.com/admin/finance",
      "permanent": true
    },
    {
      "source": "/admin/khqr",
      "destination": "https://shop.brathna.com/admin/khqr",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/verify/:id",
      "destination": "/api/player?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
